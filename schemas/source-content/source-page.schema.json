{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam-guru.local/schemas/source-content/source-page.schema.json",
  "title": "Source page transcription",
  "description": "One page of pure source-fidelity transcription from a single reader. Contains only what is visibly printed. No educational interpretation, no correction, no normalisation. Used unchanged by Codex/Astra, Qwen, Ornith and the machine candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "page_number", "grade", "subject", "medium", "provider", "regions"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "document_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 128 },
    "page_number": { "type": "integer", "minimum": 1 },
    "grade": { "type": "integer", "minimum": 1, "maximum": 13 },
    "subject": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "medium": { "type": "string", "enum": ["sinhala", "tamil", "english"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "kind": { "type": "string", "enum": ["primary", "independent", "machine-candidate", "human"] },
        "model": { "type": "string", "maxLength": 256 },
        "model_digest": { "type": "string", "maxLength": 128 },
        "runtime": { "type": "string", "maxLength": 128 },
        "attempt": { "type": "integer", "minimum": 1, "default": 1 },
        "read_at": { "type": "string", "format": "date-time" },
        "source_image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "regions": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/region" } },
    "unreadable": {
      "type": "boolean",
      "default": false,
      "description": "True when the reader could not transcribe the page at all. Prefer this over inventing text."
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "description": "[x0, y0, x1, y1] in rendered-page pixels; deterministic code owns geometry.",
      "items": { "type": "number", "minimum": 0 },
      "minItems": 4,
      "maxItems": 4
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "kind", "text"],
      "properties": {
        "region_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
        "kind": {
          "type": "string",
          "enum": [
            "title", "subtitle", "paragraph", "list-item", "equation", "number",
            "url", "email", "table", "figure-label", "header", "footer", "page-number", "other"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 20000,
          "description": "Exact visible Unicode. Preserve printed X versus \u00d7, spaces around @, punctuation and spelling as printed. Empty string means nothing is printed here."
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "reading_order": { "type": "integer", "minimum": 0 },
        "uncertain": { "type": "boolean", "default": false },
        "uncertain_note": { "type": "string", "maxLength": 512 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "table": { "$ref": "#/$defs/table" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "table" } }, "required": ["kind"] },
          "then": { "required": ["table"] }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "cells"],
      "properties": {
        "rows": { "type": "integer", "minimum": 1, "maximum": 512 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 512 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "cells": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "text", "blank"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "maxLength": 4000 },
        "blank": {
          "type": "boolean",
          "description": "True when the printed cell is empty. A blank cell must stay blank and must never be filled in."
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "uncertain": { "type": "boolean", "default": false },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
