{
  "components": {
    "schemas": {
      "DependencyChecks": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "valkey": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Valkey",
            "type": "string"
          }
        },
        "required": [
          "database",
          "valkey"
        ],
        "title": "DependencyChecks",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/DependencyChecks"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "TaxonomyLevel": {
        "enum": [
          "competency",
          "skill",
          "sub_skill",
          "learning_concept"
        ],
        "title": "TaxonomyLevel",
        "type": "string"
      },
      "TaxonomyNodeCreate": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "default": true,
            "title": "Active",
            "type": "boolean"
          },
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/TaxonomyLevel"
          },
          "parent_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "level",
          "code",
          "title"
        ],
        "title": "TaxonomyNodeCreate",
        "type": "object"
      },
      "TaxonomyNodeResponse": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "curriculum_version_id": {
            "format": "uuid",
            "title": "Curriculum Version Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/TaxonomyLevel"
          },
          "parent_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "curriculum_version_id",
          "parent_id",
          "level",
          "code",
          "title",
          "active"
        ],
        "title": "TaxonomyNodeResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AI Exam Guru API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/curricula/{curriculum_version_id}/taxonomy/nodes": {
      "get": {
        "operationId": "list_taxonomy_nodes",
        "parameters": [
          {
            "in": "path",
            "name": "curriculum_version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Curriculum Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaxonomyNodeResponse"
                  },
                  "title": "Response List Taxonomy Nodes",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List curriculum taxonomy nodes",
        "tags": [
          "admin-taxonomy"
        ]
      },
      "post": {
        "operationId": "create_taxonomy_node",
        "parameters": [
          {
            "in": "path",
            "name": "curriculum_version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Curriculum Version Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaxonomyNodeCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyNodeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Curriculum version not found"
          },
          "409": {
            "description": "Taxonomy conflict"
          },
          "422": {
            "description": "Invalid taxonomy hierarchy"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create a curriculum taxonomy node",
        "tags": [
          "admin-taxonomy"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "get_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check API liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Check API dependencies",
        "tags": [
          "health"
        ]
      }
    }
  }
}
