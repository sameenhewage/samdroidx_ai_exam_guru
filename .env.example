POSTGRES_DB=exam_guru
POSTGRES_USER=exam_guru
POSTGRES_PASSWORD=exam-guru-local-db
POSTGRES_PORT=55432
VALKEY_PORT=56379
MINIO_ROOT_USER=exam-guru-local
MINIO_ROOT_PASSWORD=exam-guru-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=3000
APP_ENVIRONMENT=local
APP_BASE_URL=http://localhost:3000
EXAM_GURU_IDENTITY_PROVIDER=deterministic
DETERMINISTIC_ADMIN_TOKEN=exam-guru-admin-local-token
DETERMINISTIC_REVIEWER_TOKEN=exam-guru-reviewer-local-token
ENABLE_DETERMINISTIC_IDENTITY=true
ADMIN_COOKIE_SECURE=false
# Production must set identity_provider=oidc and every bounded control below explicitly.
# EXAM_GURU_OIDC_ISSUER=https://identity.internal.example/realms/exam-guru
# EXAM_GURU_OIDC_AUDIENCE=exam-guru-api
# EXAM_GURU_OIDC_JWKS_URL=https://identity.internal.example/realms/exam-guru/jwks
# Cross-origin JWKS is rejected unless this exact origin is explicitly trusted:
# EXAM_GURU_OIDC_TRUSTED_JWKS_ORIGIN=https://keys.internal.example
# EXAM_GURU_OIDC_ROLE_CLAIM_NAME=roles
# EXAM_GURU_OIDC_ADMIN_ROLE=exam-guru-admin
# EXAM_GURU_OIDC_REVIEWER_ROLE=exam-guru-reviewer
# EXAM_GURU_OIDC_MAX_TOKEN_AGE_SECONDS=3600
# EXAM_GURU_OIDC_CLOCK_SKEW_SECONDS=30
# EXAM_GURU_OIDC_JWKS_TIMEOUT_SECONDS=2
# EXAM_GURU_OIDC_JWKS_CACHE_SECONDS=300
# EXAM_GURU_OIDC_JWKS_MAX_CACHED_KEYS=16
# EXAM_GURU_OIDC_ALGORITHMS=["RS256","ES256"]
# OCR remains disabled unless a worker explicitly sets this provider.
# EXAM_GURU_OCR_PROVIDER=tesseract
EXAM_GURU_OCR_TESSERACT_EXECUTABLE=tesseract
EXAM_GURU_OCR_TESSERACT_LANGUAGE=sin+eng
EXAM_GURU_OCR_TESSERACT_MAX_SOURCE_BYTES=26214400
EXAM_GURU_OCR_TESSERACT_MAX_PAGES=16
EXAM_GURU_OCR_TESSERACT_DPI=300
EXAM_GURU_OCR_TESSERACT_BATCH_SIZE=4
EXAM_GURU_OCR_TESSERACT_TIMEOUT_SECONDS=10
EXAM_GURU_OCR_TESSERACT_PAGE_SEGMENTATION_MODE=3
EXAM_GURU_OCR_TESSERACT_MAX_PIXELS_PER_PAGE=40000000
EXAM_GURU_OCR_TESSERACT_MAX_COMMAND_OUTPUT_BYTES=8388608
# Local/test intentionally resolve an unset embedding provider to the deterministic default below.
# Staging/production do not: ingestion fails closed until a real adapter is implemented/configured.
# EXAM_GURU_RETRIEVAL_EMBEDDING_PROVIDER=deterministic
EXAM_GURU_RETRIEVAL_EMBEDDING_MODEL=grade5-deterministic-shake256
EXAM_GURU_RETRIEVAL_EMBEDDING_DIMENSION=32
EXAM_GURU_RETRIEVAL_EMBEDDING_VERSION=v1
EXAM_GURU_RETRIEVAL_EMBEDDING_CONFIG_FINGERPRINT=sha256:51c1987251b1c8d373ecb6d476c2d00ae60da5173aa544a2ff4524a9141d3d89
EXAM_GURU_EXTRACTION_RECOVERY_BATCH_SIZE=50
EXAM_GURU_EXTRACTION_OUTBOX_MIN_AGE_SECONDS=5
EXAM_GURU_MAINTENANCE_SCHEDULER_INTERVAL_SECONDS=30
EXAM_GURU_STORAGE_RECONCILIATION_INTERVAL_SECONDS=3600
EXAM_GURU_STORAGE_RECONCILIATION_GRACE_SECONDS=86400
EXAM_GURU_STORAGE_RECONCILIATION_MAX_OBJECTS_PER_RUN=1000
# Dry-run persistence is the default. Production may explicitly enable only these reversible app tags.
EXAM_GURU_STORAGE_RECONCILIATION_APPLY_TAGS=false
EXAM_GURU_EMBEDDING_RECOVERY_BATCH_SIZE=50
EXAM_GURU_EMBEDDING_OUTBOX_MIN_AGE_SECONDS=5
EXAM_GURU_EMBEDDING_WORKER_LEASE_SECONDS=600
# Per-principal controls below cover authenticated costly operations and fail closed on Valkey.
# Production ingress must also enforce unauthenticated/per-IP DDoS controls; these settings do
# not provide edge or network DDoS protection. Idempotent duplicate attempts consume one unit.
EXAM_GURU_RATE_LIMITS_ENABLED=true
EXAM_GURU_RATE_LIMIT_WINDOW_SECONDS=60
EXAM_GURU_RATE_LIMIT_SOURCE_UPLOAD=30
EXAM_GURU_RATE_LIMIT_EXTRACTION_TRIGGER=60
EXAM_GURU_RATE_LIMIT_EMBEDDING_JOB_CREATE=30
EXAM_GURU_RATE_LIMIT_GENERATION_CREATE_RETRY=20
EXAM_GURU_RATE_LIMIT_VALIDATION_RUN=60
EXAM_GURU_RATE_LIMIT_PAPER_PUBLISH_ARCHIVE=30
